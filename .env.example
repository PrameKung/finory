# Auth and ledger use separate PostgreSQL databases.
AUTH_DATABASE_URL=postgresql://USER:PASSWORD@NEON_HOST/auth_db?sslmode=require
LEDGER_DATABASE_URL=postgresql://USER:PASSWORD@NEON_HOST/ledger_db?sslmode=require

# Optional host port for Docker Compose.
API_PORT=8080

# Required JWT signing secret. Use a random value with at least 32 bytes.
JWT_ACCESS_SECRET=

# Google OAuth web client credentials and the exact callback URL registered in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback
APP_REDIRECT_URL=http://localhost:3000/dashboard

# Optional comma-separated frontend origins allowed by the API.
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
