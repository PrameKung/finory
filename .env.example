# Replace both URLs with connection strings for separate databases in one Neon project.
AUTH_DATABASE_URL=postgresql://USER:PASSWORD@NEON_HOST/auth_db?sslmode=require
LEDGER_DATABASE_URL=postgresql://USER:PASSWORD@NEON_HOST/ledger_db?sslmode=require

# Optional host port for Docker Compose. Each Go service has its own internal PORT.
API_GATEWAY_PORT=8080

# Required gateway secret for verifying access tokens. Generate a random value with at least 32 bytes.
JWT_ACCESS_SECRET=

# Google OAuth web client credentials and the exact callback URL registered in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback
APP_REDIRECT_URL=http://localhost:3000/

# Optional comma-separated frontend origins allowed by the API Gateway.
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional internal service URLs for Docker Compose. Leave these commented for the default service names.
# AUTH_SERVICE_URL=http://auth-service:8081
# LEDGER_SERVICE_URL=http://ledger-service:8082
# ANALYTICS_SERVICE_URL=http://analytics-service:8083
