FROM golang:1.26-alpine AS build

ARG SERVICE
WORKDIR /src
COPY backend/services/${SERVICE}/go.mod backend/services/${SERVICE}/go.sum ./
RUN go mod download
COPY backend/services/${SERVICE}/ ./
RUN CGO_ENABLED=0 go build -o /out/server ./cmd/api

FROM alpine:3.22
RUN apk add --no-cache ca-certificates
COPY --from=build /out/server /server
USER 10001:10001
ENTRYPOINT ["/server"]
